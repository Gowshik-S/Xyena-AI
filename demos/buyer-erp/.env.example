ERP_DEMO_DATABASE_URL=sqlite+aiosqlite:///./buyer-erp.db
ERP_DEMO_MCP_TOKEN=replace-with-shared-xyena-mcp-workload-token
ERP_DEMO_UI_TOKEN=replace-with-local-dashboard-token
ERP_DEMO_ADMIN_TOKEN=replace-with-separate-operator-token
ERP_DEMO_GST_EVENT_SECRET=replace-with-gst-event-signing-secret
ERP_DEMO_GST_BASE_URL=
ERP_DEMO_GST_SERVICE_TOKEN=
ERP_DEMO_HOST=0.0.0.0
ERP_DEMO_PORT=8092

# Used by the Xyena registration utility.
XYENA_MCP_CONTROL_URL=http://localhost:8081
XYENA_SERVICE_TOKEN=replace-with-xyena-service-token
XYENA_MCP_ADMIN_TOKEN=replace-with-xyena-mcp-admin-token
ERP_DEMO_PUBLIC_MCP_URL=http://buyer-erp:8092/mcp
ERP_DEMO_TENANT_ID=00000000-0000-4000-8000-000000000101
