DELIVERY_DEMO_DATABASE_URL=sqlite+aiosqlite:///./delivery-demo.db
DELIVERY_DEMO_MCP_TOKEN=replace-with-the-same-value-used-by-xyena-secret-ref
DELIVERY_DEMO_SOURCE_SIGNING_KEY=replace-with-source-envelope-signing-key
DELIVERY_DEMO_EVENT_SIGNING_KEY=replace-with-cross-app-event-signing-key
DELIVERY_DEMO_VIEWER_TOKEN=replace-with-viewer-token
DELIVERY_DEMO_SELLER_TOKEN=replace-with-seller-operator-token
DELIVERY_DEMO_CARRIER_TOKEN=replace-with-carrier-operator-token
DELIVERY_DEMO_BUYER_TOKEN=replace-with-buyer-receiver-token
DELIVERY_DEMO_REVIEWER_TOKEN=replace-with-independent-reviewer-token
DELIVERY_DEMO_ADMIN_TOKEN=replace-with-demo-admin-token
DELIVERY_DEMO_HOST=0.0.0.0
DELIVERY_DEMO_PORT=8095

# Used only by the registration utility.
XYENA_MCP_CONTROL_URL=http://localhost:8081
XYENA_SERVICE_TOKEN=replace-with-xyena-service-token
XYENA_MCP_ADMIN_TOKEN=replace-with-xyena-mcp-admin-token
DELIVERY_DEMO_PUBLIC_MCP_URL=http://delivery-demo:8095/mcp
DELIVERY_DEMO_TENANT_ID=00000000-0000-4000-8000-000000000101
