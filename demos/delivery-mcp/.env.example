DELIVERY_DEMO_DATABASE_URL=sqlite+aiosqlite:///./delivery-demo.db
DELIVERY_DEMO_MCP_TOKEN=replace-with-the-same-value-used-by-xyena-secret-ref
DELIVERY_DEMO_UI_TOKEN=replace-with-local-demo-ui-token
