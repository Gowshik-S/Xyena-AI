    classDef actor fill:#ffffff,stroke:#8296b2,color:#14243e,stroke-width:1.5px;
    classDef boundary fill:#13233f,stroke:#13233f,color:#ffffff,stroke-width:2px;
    classDef context fill:#e7f8f6,stroke:#0c9696,color:#123c42,stroke-width:1.5px;
    classDef memory fill:#f3effb,stroke:#8264b5,color:#2f2051,stroke-width:1.5px;
    classDef agent fill:#f7f9fc,stroke:#6f84a1,color:#14243e,stroke-width:1.5px;
    classDef decision fill:#eaf1ff,stroke:#2e6fd8,color:#173a72,stroke-width:1.6px;
    classDef guardian fill:#533494,stroke:#3f267f,color:#ffffff,stroke-width:2.5px;
    classDef mcp fill:#e9f5f5,stroke:#0c8791,color:#123c42,stroke-width:1.5px;
    classDef protected fill:#13233f,stroke:#13233f,color:#ffffff,stroke-width:2px;
    classDef warning fill:#fff3e2,stroke:#d9901e,color:#6f4500,stroke-width:1.5px;
    classDef danger fill:#fcebed,stroke:#d64958,color:#7e1d29,stroke-width:1.5px;
    classDef store fill:#ffffff,stroke:#8296b2,color:#14243e,stroke-width:1.4px;

    class MSME,REVIEWERS,FUNDERS actor;
    class IAM,SCOPE boundary;
    class MEMORYPOLICY,RETRIEVAL,ASSEMBLER,ENVELOPE,NORMALIZER,RECEIPTS,REQUIREMENTS context;
    class MEMORY memory;
    class SUPERVISOR,AGENTPOOL agent;
    class ORCHESTRATOR,EXPOSURE,PROPOSAL decision;
    class GUARDIAN,CALLMON guardian;
    class VERDICT,VERIFY,ESCALATE warning;
    class BLOCK danger;
    class AUTHORIZATION,EXECUTION,FINANCE protected;
    class TOOLPOLICY,MCPGATEWAY,SUPPLYMCP,DOMAINMCP mcp;
    class SANDBOX,QUARANTINE warning;
    class EVIDENCE,DIGITAL,MONITOR,FEEDBACK,OLTP,VECTOR,OBJECTS,RECEIPTSTORE,GRAPH,AUDIT,EVENTS store;
    linkStyle default stroke:#506581,stroke-width:1.8px;
